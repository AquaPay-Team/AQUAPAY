    {
      "name": "02. SuperAdmin Setup & Admin Login",
      "item": [
        {
          "name": "POST 1. Create SuperAdmin Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (pm.response.code === 201 || pm.response.code === 409) {",
                  "    console.log(\"SuperAdmin account ready for login.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-admin-setup-key",
                "value": "{{adminSetupKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"System SuperAdmin\",\n  \"email\": \"{{adminEmail}}\",\n  \"mobile\": \"{{adminMobile}}\",\n  \"companyName\": \"AquaPay Fintech Solutions Private Limited\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "create"]
            }
          }
        },
        {
          "name": "POST 2. SuperAdmin Login (Captures adminToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set(\"adminToken\", res.data.accessToken);",
                  "    console.log(\"Admin Token successfully captured into collection variables!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
