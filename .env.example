PORT=3000

# Configure these for Oracle MySQL Community Server only.
# Port 3307 avoids the currently occupied XAMPP/MariaDB port 3306.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=aquapay_app
DB_PASSWORD=replace_with_a_unique_database_password
DB_NAME=fintech_kyc

# Generate at least 32 random bytes, for example with
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRES_IN=1h

AUTH_BCRYPT_SALT_ROUNDS=12
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_RESET_TOKEN_TTL_MINUTES=15
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_IP_LIMIT=60
AUTH_LOGIN_IDENTIFIER_LIMIT=10
AUTH_RECOVERY_WINDOW_SECONDS=3600
AUTH_RECOVERY_IP_LIMIT=30
AUTH_RECOVERY_IDENTIFIER_LIMIT=5
AUTH_RESET_TOKEN_LIMIT=10
