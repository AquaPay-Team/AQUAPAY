    {
      "name": "07. KYC Step 2 — Aadhaar Document Verification (DigiLocker)",
      "item": [
        {
          "name": "POST 1. Initiate Aadhaar Verification (Captures state)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.authorizationUrl) {",
                  "    try {",
                  "        const parsed = new URL(res.data.authorizationUrl);",
                  "        const state = parsed.searchParams.get(\"state\");",
                  "        if (state) {",
                  "            pm.collectionVariables.set(\"digilockerAadhaarState\", state);",
                  "            console.log(\"Captured digilockerAadhaarState:\", state);",
                  "        }",
                  "    } catch (e) {",
                  "        console.error(\"Could not parse state from URL:\", e);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consent\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/kyc/digilocker/aadhaar/initiate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "kyc", "digilocker", "aadhaar", "initiate"]
            }
          }
        },
        {
          "name": "GET 2. DigiLocker Mock Authorize (Sandbox Simulator)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/kyc/digilocker/mock-authorize?state={{digilockerAadhaarState}}&document=ADHAR",
              "host": ["{{baseUrl}}"],
              "path": ["api", "kyc", "digilocker", "mock-authorize"],
              "query": [
                {
                  "key": "state",
                  "value": "{{digilockerAadhaarState}}"
                },
                {
                  "key": "document",
                  "value": "ADHAR"
                }
              ]
            }
          }
        },
        {
          "name": "GET 3. DigiLocker Callback for Aadhaar (Completes Step 2)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/kyc/digilocker/callback?code=aquapay-mock-adhar-v1&state={{digilockerAadhaarState}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "kyc", "digilocker", "callback"],
              "query": [
                {
                  "key": "code",
                  "value": "aquapay-mock-adhar-v1"
                },
                {
                  "key": "state",
                  "value": "{{digilockerAadhaarState}}"
                }
              ]
            }
          }
        }
      ]
    },
