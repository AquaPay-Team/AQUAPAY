              "host": ["{{baseUrl}}"],
              "path": ["api", "kyc", "digilocker", "pan", "initiate"]
            }
          }
        },
        {
          "name": "GET DigiLocker Callback for PAN (Completes Step 3)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/kyc/digilocker/callback?code=aquapay-mock-pan-v1&state={{digilockerState}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "kyc", "digilocker", "callback"],
