
PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fintech_kyc
DB_PASSWORD=replace_me
DB_NAME=fintech_kyc

# KYC Step 1 OTP (Redis stores temporary challenge hashes only)
REDIS_URL=redis://127.0.0.1:6379
KYC_OTP_SECRET=replace_with_at_least_32_random_bytes

ADMIN_SETUP_KEY=replace_with_a_long_random_setup_key

# Authentication
# Use a unique, randomly generated secret of at least 32 bytes.
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRES_IN=1h

AUTH_BCRYPT_SALT_ROUNDS=12
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_RESET_TOKEN_TTL_MINUTES=15
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_IP_LIMIT=60
AUTH_LOGIN_IDENTIFIER_LIMIT=10
AUTH_RECOVERY_WINDOW_SECONDS=3600
AUTH_RECOVERY_IP_LIMIT=30
AUTH_RECOVERY_IDENTIFIER_LIMIT=5
AUTH_RESET_TOKEN_LIMIT=10
CORS_ORIGINS=http://localhost:5173

# IDTO DigiLocker V1. Register this HTTPS callback URL with IDTO.
IDTO_PROVIDER_MODE=idto
IDTO_BASE_URL=https://prod.idto.ai
IDTO_CLIENT_ID=replace_with_idto_client_id
IDTO_API_KEY=replace_with_idto_api_key
IDTO_REDIRECT_URL=https://your-domain.example/api/kyc/digilocker/callback
# Keep false unless using the explicitly isolated, loopback-only local dev flow described in docs/IDTO_LOCAL_DEVELOPMENT.md.
IDTO_SKIP_XML_SIGNATURE_VERIFICATION=false
IDTO_DEV_UNVERIFIED_DATABASE=false

# Development/test mock only. Never set IDTO_PROVIDER_MODE=mock in production.
IDTO_MOCK_BASE_URL=http://127.0.0.1:3000
IDTO_MOCK_SIGNING_CERT_PATH=src/modules/kyc/document-verification/digilocker/fixtures/mock-signing-cert.crt

# Paths to trusted issuer certificates used to verify signed DigiLocker XML.
# These are public certificates, not application secrets.
IDTO_AADHAAR_XML_TRUSTED_CERT_PATH=
IDTO_PAN_XML_TRUSTED_CERT_PATH=

# Field-level KYC identity encryption. Generate a unique 32-byte key per environment
# and store it in a secret manager in deployed environments. Never use the DEV key in production.
KYC_IDENTITY_ENCRYPTION_ACTIVE_KEY_VERSION=1
KYC_IDENTITY_DEV_ENCRYPTION_KEY_V1=base64_encode_a_unique_32_byte_development_key
# Production uses a separate key namespace; do not copy the development key here.
KYC_IDENTITY_PROD_ENCRYPTION_KEY_V1=
