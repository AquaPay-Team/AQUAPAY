    {
      "name": "7. KYC Step 2 — Aadhaar Document Verification",
      "item": [
        {
          "name": "POST Initiate Aadhaar Verification (Auto-captures state)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.authorizationUrl) {",
                  "    try {",
                  "        const parsed = new URL(res.data.authorizationUrl);",
                  "        const state = parsed.searchParams.get(\"state\");",
                  "        if (state) {",
                  "            pm.collectionVariables.set(\"digilockerState\", state);",
                  "            console.log(\"Captured digilockerState:\", state);",
                  "        }",
                  "    } catch (e) {",
                  "        console.error(\"Could not parse state from URL:\", e);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consent\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/kyc/digilocker/aadhaar/initiate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "kyc", "digilocker", "aadhaar", "initiate"]
            }
          }
        },
        {
          "name": "GET DigiLocker Mock Authorize (Sandbox Simulator)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/kyc/digilocker/mock-authorize?state={{digilockerState}}&document=ADHAR",
              "host": ["{{baseUrl}}"],
              "path": ["api", "kyc", "digilocker", "mock-authorize"],
              "query": [
                {
                  "key": "state",
                  "value": "{{digilockerState}}"
                },
                {
                  "key": "document",
                  "value": "ADHAR"
                }
              ]
            }
          }
        },
        {
          "name": "GET DigiLocker Callback (Completes Step 2)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/kyc/digilocker/callback?code=aquapay-mock-adhar-v1&state={{digilockerState}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "kyc", "digilocker", "callback"],
              "query": [
                {
                  "key": "code",
                  "value": "aquapay-mock-adhar-v1"
                },
                {
                  "key": "state",
                  "value": "{{digilockerState}}"
                }
              ]
            }
          }
        }
      ]
    },
