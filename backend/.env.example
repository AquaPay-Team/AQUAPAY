
# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=production

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=replace_with_database_password
DB_NAME=fintech_kyc

# ==========================================
# REDIS CONFIGURATION
# ==========================================
REDIS_URL=redis://127.0.0.1:6379

# ==========================================
# KYC OTP CONFIGURATION
# ==========================================
KYC_OTP_SECRET=replace_with_at_least_32_random_bytes

# ==========================================
# ADMIN CONFIGURATION
# ==========================================
ADMIN_SETUP_KEY=replace_with_a_long_random_setup_key

# ==========================================
# AUTHENTICATION CONFIGURATION
# ==========================================
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRES_IN=1h
AUTH_OTP_HMAC_SECRET=replace_with_a_distinct_32_byte_minimum_secret
AUTH_RATE_LIMIT_HMAC_SECRET=replace_with_a_distinct_32_byte_minimum_secret
AUTH_ALLOW_DEVELOPMENT_SECRETS=false

AUTH_BCRYPT_SALT_ROUNDS=12
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_RESET_TOKEN_TTL_MINUTES=15

AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_IP_LIMIT=60
AUTH_LOGIN_IDENTIFIER_LIMIT=10

AUTH_RECOVERY_WINDOW_SECONDS=3600
AUTH_RECOVERY_IP_LIMIT=30
AUTH_RECOVERY_IDENTIFIER_LIMIT=5

AUTH_RESET_TOKEN_LIMIT=10

# ==========================================
# CORS CONFIGURATION
# ==========================================
CORS_ORIGINS=http://localhost:5173

# ==========================================
# IDTO / DIGILOCKER CONFIGURATION
# ==========================================
# PAN Detailed v2 uses this same IDTO mode and credentials; its endpoint is
# fixed in the PAN provider adapter. No PAN-specific key or idempotency field.
IDTO_PROVIDER_MODE=idto
IDTO_BASE_URL=https://prod.idto.ai

IDTO_CLIENT_ID=replace_with_idto_client_id
IDTO_API_KEY=replace_with_idto_api_key
IDTO_REDIRECT_URL=https://your-domain.example/api/kyc/digilocker/callback

# Existing PAN signature-policy settings; Aadhaar parsing does not use this bypass.
IDTO_SKIP_XML_SIGNATURE_VERIFICATION=false
IDTO_DEV_UNVERIFIED_DATABASE=false

# ==========================================
# DIGILOCKER MOCK CONFIGURATION
# ==========================================
IDTO_MOCK_BASE_URL=http://127.0.0.1:3000
IDTO_MOCK_SIGNING_CERT_PATH=src/modules/kyc/document-verification/digilocker/fixtures/mock-signing-cert.crt

# ==========================================
# Existing PAN XML signature trust configuration
# Aadhaar XML is structurally/business validated and is not cryptographically verified.
# ==========================================
IDTO_PAN_XML_TRUSTED_CERT_PATH=

# ==========================================
# KYC IDENTITY ENCRYPTION
# ==========================================
KYC_IDENTITY_ENCRYPTION_ACTIVE_KEY_VERSION=1
KYC_IDENTITY_DEV_ENCRYPTION_KEY_V1=replace_with_base64_encoded_32_byte_key
KYC_IDENTITY_PROD_ENCRYPTION_KEY_V1=

# ==========================================
# KYC PROVIDER SESSION ENCRYPTION
# Encrypts short-lived IDTO reference keys persisted for callback processing.
# Generate independent environment-specific 32-byte keys; never reuse local keys in production.
# ==========================================
KYC_PROVIDER_SESSION_ENCRYPTION_ACTIVE_KEY_VERSION=1
KYC_PROVIDER_SESSION_DEV_ENCRYPTION_KEY_V1=replace_with_base64_encoded_32_byte_key
KYC_PROVIDER_SESSION_TEST_ENCRYPTION_KEY_V1=
KYC_PROVIDER_SESSION_PROD_ENCRYPTION_KEY_V1=

# ==========================================
# BANK ACCOUNT ENCRYPTION
# ==========================================
BANK_ACCOUNT_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key

# ==========================================
# CLOUDINARY CONFIGURATION
# ==========================================
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret
